<Project>

  <!--
    Central Package Management — jedyne miejsce, gdzie żyją wersje pakietów NuGet.
    Projekty piszą <PackageReference Include="X" /> BEZ atrybutu Version.
    Włączone przez ManagePackageVersionsCentrally w Directory.Build.props.
  -->

  <ItemGroup Label="API / endpointy">
    <PackageVersion Include="FastEndpoints" Version="8.2.0" />
    <PackageVersion Include="FastEndpoints.Swagger" Version="8.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Uwierzytelnianie">
    <!-- Handler JWT wysyłany razem z Microsoft.AspNetCore.App, ale bez jawnego pakietu
         referencja się nie rozwiązuje przy kompilacji (tylko w runtime) — patrz ErpAuthExtensions. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Rozszerzenia platformy">
    <!-- Biblioteki klas (nie Web SDK) nie dostają tych typów z frameworka — stąd jawne pakiety. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <!-- Overload `services.Configure<T>(IConfiguration)` — bindowanie opcji z appsettings. -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <!-- Pełny host (nie same abstrakcje) — potrzebny testom integracyjnym, które stawiają
         dwa niezależne procesy-węzły w jednym procesie testowym. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Walidacja">
    <!-- FastEndpoints ma FluentValidation w środku, ale walidatory komend żyją w warstwie
         Application, która nie może referencować FastEndpoints — stąd jawna referencja. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Persystencja">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- snake_case dla tabel i kolumn — konwencja Postgresa, bez ręcznego HasColumnName. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <!--
      Wolverine (MIT) zamiast MassTransita: v9 MassTransita jest komercyjny (min. $400/mies.),
      a v8 (Apache 2.0) wchodzi w EOL z końcem 2026.

      Wolverine wnosi durable outbox na Postgresie zintegrowany z transakcją EF Core, więc
      NIE piszemy własnej tabeli `outbox_message` — envelope'y trzymają tabele Wolverine'a
      w schemacie `wolverine`. Rola FastEndpoints Command Bus zostaje bez zmian
      (dyspozycja komend in-process: HTTP → command, oraz BulkCommandRunner);
      Wolverine odpowiada wyłącznie za komunikację MIĘDZY serwisami.
    -->
    <PackageVersion Include="WolverineFx" Version="6.28.0" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.28.0" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.28.0" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.28.0" />
    <!--
      Od v6 rdzeń Wolverine'a nie zawiera już kompilatora runtime, a domyślny tryb
      TypeLoadMode.Dynamic generuje kod handlerów przy starcie — bez tego pakietu host
      w ogóle się nie podnosi.

      Kod można wygenerować z wyprzedzeniem: komenda `codegen write` uruchomiona w projekcie Api
      zapisuje go do `Internal/Generated`, a `Messaging:PrecompiledHandlers=true` przełącza
      Wolverine'a na TypeLoadMode.Static — szybszy start, brak Roslyna w obrazie i brak wyścigu
      na generowanym kodzie przy równoległym starcie instancji. Flaga jest domyślnie WYŁĄCZONA:
      zatwierdzony kod trzeba regenerować przy każdej zmianie kształtu handlera, więc włączenie
      jej jest decyzją wdrożenia, nie stanem domyślnym. Patrz docs/architecture/multi-instance.md.
    -->
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.28.0" />
  </ItemGroup>

  <ItemGroup Label="Artefakty">
    <!-- Klient S3 do MinIO — magazyn plików produkowanych przez eksporty i raporty.
         Patrz docs/guides/backend/exports-artifacts.md. -->
    <PackageVersion Include="Minio" Version="7.0.0" />

    <!-- Generowanie miniaturek. SkiaSharp (MIT nad Skia na BSD-3), NIE ImageSharp: ten od v3
         chodzi na Six Labors Split License z progiem przychodowym, czyli dokładnie ta klasa
         zależności, którą ten projekt już raz odrzucił przy MassTransit v9 i MediatR v13.
         Patrz docs/guides/backend/media-storage.md. -->
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />

    <!-- Natywne libSkiaSharp.so dla obrazów kontenerowych. Wariant `NoDependencies` świadomie:
         wersja pełna ciągnie fontconfig, a my nie rysujemy tekstu — tylko dekodujemy i skalujemy.
         Na obrazie bez fontconfiga pełna wersja wywraca się przy pierwszym użyciu, nie przy starcie. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />

    <!-- Oczyszczanie HTML wpisanego przez użytkownika w edytorze tekstu formatowanego
         (`erp-rich-text`). MIT, oparte o AngleSharp — parsuje dokument tak jak przeglądarka,
         zamiast filtrować regexem, więc nie da się go obejść przez egzotyczne kodowanie znaków.
         Sanityzacja idzie przy ZAPISIE, nie przy renderowaniu: front i tak sanityzuje po swojej
         stronie, ale zapisany HTML czytają też eksporty, powiadomienia i integracje. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.995" />
  </ItemGroup>

  <ItemGroup Label="Realtime">
    <!-- Backplane SignalR: jedyne miejsce w systemie, gdzie potrzebny jest Redis.
         Włączany warunkowo przez `Realtime:Redis` — patrz docs/architecture/multi-instance.md. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Logowanie">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Testy">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.14.0" />
  </ItemGroup>

</Project>
