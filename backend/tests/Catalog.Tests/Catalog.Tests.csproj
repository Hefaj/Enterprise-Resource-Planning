<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Kod testowy nie musi spełniać rygoru analizatorów fundamentu. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      xunit v3 uruchamia się na Microsoft.Testing.Platform, a nie na VSTest: każdy projekt
      testowy jest samodzielnym programem, stąd OutputType=Exe. Bez tych dwóch właściwości
      `dotnet test` buduje projekt, ale nie znajduje w nim ani jednego testu.
    -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../modules/Catalog/Catalog.Domain/Catalog.Domain.csproj" />
    <ProjectReference Include="../../modules/Catalog/Catalog.Application/Catalog.Application.csproj" />
    <!-- Translator naruszeń unikalności — druga warstwa reguły duplikatu, obok pre-checku. -->
    <ProjectReference Include="../../building-blocks/Erp.BuildingBlocks.Persistence/Erp.BuildingBlocks.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
