{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "NotificationDb": "Host=127.0.0.1;Port=5432;Database=erp;Username=erp;Password=erp"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Messaging": {
    "ServiceName": "Notification",
    "RabbitMqConnectionString": "amqp://erp:erp@localhost:5672",
    "PostgresConnectionString": "Host=127.0.0.1;Port=5432;Database=erp;Username=erp;Password=erp",
    "AutoProvision": true,
    "ListenQueueName": "notification.events"
  },
  "Realtime": {
    "InvalidationThreshold": 1000,
    "CoalesceWindow": "00:00:00.200"
  }
}
