{
  "realm": "erp",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "clients": [
    {
      "clientId": "erp-client",
      "name": "Erp SPA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "erp-identity-service",
      "name": "Erp Identity Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "erp-identity-service-secret"
    }
  ],
  "users": [
    {
      "username": "admin@erp.local",
      "email": "admin@erp.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "ERP",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-erp-identity-service",
      "enabled": true,
      "serviceAccountClientId": "erp-identity-service",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
