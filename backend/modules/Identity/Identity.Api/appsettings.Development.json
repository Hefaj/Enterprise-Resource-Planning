{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "IdentityDb": "Host=127.0.0.1;Port=5432;Database=erp;Username=erp;Password=erp"
  },
